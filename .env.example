# Copier en .env pour remplacer les valeurs par défaut du Compose de dev.

# URL encodée dans le QR code. Pour jouer depuis un téléphone, mettre l'IP locale du Mac : http://192.168.x.x:8080
PUBLIC_ORIGIN=http://localhost:8080

# Au moins 32 caractères aléatoires (openssl rand -base64 32). SESSION_SECRET signe les jetons de partie.
SESSION_SECRET=
BETTER_AUTH_SECRET=
